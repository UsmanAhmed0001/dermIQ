# ──────────────────────────────────────────────
# DermIQ Environment Variables
# Copy this to .env.local and fill in your values
# ──────────────────────────────────────────────

# Get your free token at: https://huggingface.co/settings/tokens
# The free tier gives you 30,000 API calls/month
HUGGINGFACE_API_TOKEN=hf_your_token_here

# The HuggingFace model we use for skin lesion classification
# This is a ViT model fine-tuned on HAM10000 (same dataset as your dissertation)
HF_MODEL_ID=Anwarkh1/Skin_Lesion-Image_Classification

# Optional: Replace with your own trained model endpoint once you train it
# HF_MODEL_ID=your-username/your-finetuned-model
